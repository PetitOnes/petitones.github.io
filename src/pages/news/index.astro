---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const items = (await getCollection('news')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
const rendered = await Promise.all(items.map(async (n) => ({ n, Content: (await render(n)).Content })));
---
<Base title="お知らせ" description="ぷちたちのお知らせ。配信、展示、発表。">
  <div class="sec"><div class="wrap prose">
    <h1>お知らせ</h1>
    {rendered.map(({ n, Content }) => (
      <article id={n.id}>
        <h2><time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time> {n.data.title}{n.data.version && <span class="v" style="margin-left:8px;font-size:.8rem;font-family:var(--pt-font-mono);color:var(--pt-teal-ink);background:var(--pt-teal-soft);border-radius:6px;padding:0 6px">{n.data.version}</span>}</h2>
        <Content />
        {n.data.link && <p><a href={n.data.link}>くわしく</a></p>}
      </article>
    ))}
  </div></div>
</Base>
