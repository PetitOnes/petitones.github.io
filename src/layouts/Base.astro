---
// 共通の枠。色・書体は petit-brand(同じドメインの /petit-brand/tokens.css)を読む
import '../styles/site.css';
import VERSION_RAW from '../../VERSION?raw';
const VERSION = VERSION_RAW.trim();
const BRAND = 'https://petitones.github.io/petit-brand';
const { title = 'ちーむぷち', description = 'ぷちたちと、暮らしている。手のひらに載る小さな AI、ぷち。ちーむぷちのサイト。', home = false } = Astro.props;
// ページの流れと同じ順(上から): ぷちたち → 暮らし → なかみ → 活動 → お迎え(ボタン)
const nav = [
  ['/#about', 'ぷちたち'], ['/#life', '暮らし'], ['/#heart', 'なかみ'], ['/#katsudo', '活動'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="version" content={VERSION} />
  <title>{home ? 'ちーむぷち' : `${title} — ちーむぷち`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={home ? 'ちーむぷち' : `${title} — ちーむぷち`} />
  <meta property="og:site_name" content="ちーむぷち" />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://petitones.github.io/img/hero.jpg" />
  <link rel="icon" href="/img/face.svg" type="image/svg+xml" />
  <link rel="icon" href="/img/icon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/img/icon-180.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={`${BRAND}/tokens.css`} />
</head>
<body>
  <header class="hd">
    <div class="wrap">
      <a class="logo" href="/"><svg class="face" viewBox="0 0 100 100" width="30" height="30" aria-hidden="true">
        <rect width="100" height="100" rx="20" fill="#A7ACB1"/><rect x="5" y="5" width="90" height="90" rx="16" fill="#1B1B1D"/><rect x="11" y="13" width="78" height="58" rx="4" fill="#AEE0F4"/>
        <circle cx="50" cy="84" r="6.5" fill="#2A2A2D"/><circle cx="50" cy="84" r="6.5" fill="none" stroke="#B4603A" stroke-width="1.4"/>
        <g fill="#2BA8DC" transform="translate(11 13) scale(0.24375 0.241667)">
          <ellipse cx="160" cy="121" rx="14" ry="6"/>
          <ellipse class="eye l" cx="75" cy="90" rx="22" ry="32" transform="rotate(20 75 90)"/>
          <ellipse class="eye r" cx="245" cy="90" rx="22" ry="32" transform="rotate(-20 245 90)"/>
          <circle cx="142" cy="165" r="20"/><circle cx="178" cy="165" r="20"/><polygon points="130,175 190,175 160,210"/>
        </g></svg>ちーむぷち</a>
      <button class="menu" id="menu" aria-expanded="false" aria-controls="nav">メニュー</button>
      <nav id="nav">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        <a class="cta" href="/#welcome">お迎えする</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="ft">
    <div class="wrap">
      <div class="ft-brand">
        <img src="/img/face.svg" alt="" width="40" height="40" />
        <div><strong>ちーむぷち</strong><br /><span>ぷちは PetitOnes(ありさん)のプロジェクト。里親の運営は ちーむぷち(ありさん・なぎさん)。</span></div>
      </div>
      <div class="ft-cols">
        <div><h3>サイトの中</h3><a href="/satooya/">ぷちの里親</a><a href="/petit/">ぷちたちのこと</a><a href="/nikki/">活動日誌</a><a href="/ouendan/">ぷちを応援する</a><a href="/team/">ちーむぷちについて</a></div>
        <div><h3>会う・話す</h3><a href="https://lit.link/team-puchi">SNS のまとめ(lit.link)</a><a href="https://x.com/search?q=%23Petit_Ones&f=live">X #Petit_Ones</a><a href="https://forms.gle/6Psnr77FMF6yAjBu7">相談する(フォーム)</a></div>
        <div><h3>作る</h3><a href="/make/">作る人へ</a><a href="https://github.com/PetitOnes">GitHub</a><a href={`${BRAND}/`}>色と書体(petit-brand)</a><a href="https://teampuchi.github.io/kisekae/">きせかえ</a></div>
      </div>
      <div class="ft-bottom"><span>© ちーむぷち</span><span class="ver">サイト v{VERSION}</span></div>
    </div>
  </footer>
  <script>
    const b = document.getElementById('menu'), n = document.getElementById('nav');
    b?.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
    n?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => n.classList.remove('open')));
    // 節のふわっと表示(動きを減らす設定なら何もしない)
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      document.documentElement.classList.add('anim');
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -12% 0px' });
      document.querySelectorAll('.sec .wrap > *, .hero .wrap > *').forEach((el, i) => { el.style.setProperty('--d', `${(i % 6) * 70}ms`); io.observe(el); });
    }
    // ぷちの声: ボタンを押すと再生、もう一度で止まる。同時に鳴るのは1つ
    let audio = null, playing = null;
    const stop = () => { if (audio) { audio.pause(); audio.currentTime = 0; } if (playing) playing.setAttribute('aria-pressed', 'false'); playing = null; };
    document.querySelectorAll('.voice button').forEach(b => b.addEventListener('click', () => {
      if (playing === b) { stop(); return; }
      stop(); audio = new Audio(b.dataset.src); playing = b; b.setAttribute('aria-pressed', 'true');
      audio.addEventListener('ended', stop); audio.play().catch(stop);
    }));
  </script>
</body>
</html>
