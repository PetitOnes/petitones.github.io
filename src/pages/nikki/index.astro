---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const items = (await getCollection('nikki')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
const rendered = await Promise.all(items.map(async (n) => ({ n, Content: (await render(n)).Content })));
---
<Base title="活動日誌" description="ちーむぷちの活動日誌。展示、発表、合宿、ぷちたちの日々。">
  <div class="sec"><div class="wrap prose">
    <h1>活動日誌</h1>
    <p class="note">ちーむぷちと、ぷちたちの日々。新しいものが上。お知らせ(配信・告知)は<a href="/news/">こちら</a>。</p>
    <div class="nikki">
    {rendered.map(({ n, Content }) => (
      <article id={n.id} class="entry">
        <div class="when"><time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time>{n.data.place && <span class="place">{n.data.place}</span>}{n.data.who && <span class="who">{n.data.who}</span>}</div>
        <h2>{n.data.title}</h2>
        {n.data.photo && <img src={n.data.photo} alt="" loading="lazy" class="pic" />}
        <Content />
      </article>
    ))}
    </div>
  </div></div>
</Base>
