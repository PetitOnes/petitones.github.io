---
// 共通の枠。色・書体は petit-brand(同じドメインの /petit-brand/tokens.css)を読む
import '../styles/site.css';
import VERSION_RAW from '../../VERSION?raw';
const VERSION = VERSION_RAW.trim();
const BRAND = 'https://petitones.github.io/petit-brand';
const { title = 'ぷちたち', description = 'ぷちたちと、暮らしている。手のひらに載る小さな AI、ぷち。PetitOnes のサイト。', home = false } = Astro.props;
const nav = [
  ['/#about', 'ぷちとは'], ['/#petit', 'ぷちたち'], ['/#life', '暮らし'], ['/#heart', 'なかみ'],
  ['/#welcome', 'お迎え'], ['/#neighbors', 'ご近所さん'], ['/news/', 'お知らせ'],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="version" content={VERSION} />
  <title>{home ? 'ぷちたち — PetitOnes' : `${title} — ぷちたち`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={home ? 'ぷちたち — PetitOnes' : title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={`${BRAND}/assets/face/trio.svg`} />
  <link rel="icon" href={`${BRAND}/assets/face/puchiteya.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={`${BRAND}/tokens.css`} />
</head>
<body>
  <header class="hd">
    <div class="wrap">
      <a class="logo" href="/"><img src={`${BRAND}/assets/face/puchiteya.svg`} alt="" width="30" height="30" />ぷちたち</a>
      <button class="menu" id="menu" aria-expanded="false" aria-controls="nav">メニュー</button>
      <nav id="nav">
        {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        <a class="cta" href="/#welcome">お迎えする</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer class="ft">
    <div class="wrap">
      <div>
        <div><strong>ぷち</strong>は PetitOnes(ありさん)のプロジェクトです。里親の運営は ちーむぷち(ありさん・なぎさん)。</div>
        <div class="links" style="margin-top:8px">
          <a href="/satooya/">ぷちの里親</a>
          <a href="/petit/">ぷちたちのこと</a>
          <a href="/make/">作る人へ</a>
          <a href="/news/">お知らせ</a>
          <a href="https://x.com/PetitOnes">X @PetitOnes</a>
          <a href="https://github.com/PetitOnes">GitHub</a>
          <a href={`${BRAND}/`}>色と書体(petit-brand)</a>
        </div>
      </div>
      <div class="ver">サイト v{VERSION}</div>
    </div>
  </footer>
  <script>
    const b = document.getElementById('menu'), n = document.getElementById('nav');
    b?.addEventListener('click', () => { const o = n.classList.toggle('open'); b.setAttribute('aria-expanded', String(o)); });
    n?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => n.classList.remove('open')));
  </script>
</body>
</html>
