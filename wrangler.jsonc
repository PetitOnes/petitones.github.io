{
  // プレビュー(公開前に見る場所)。Cloudflare Workers の静的サイト。手引き(petit-foster-guide)と同じ作り。
  // URL: petitones-preview.<account>.workers.dev。Access(Zero Trust、teampuchi)で「運営のメールだけ」にする。
  // 出し方: npm run build && npm run preview:deploy(初回だけ `npx wrangler login`)
  "name": "petitones-preview",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "workers_dev": true,
  "preview_urls": false
}
